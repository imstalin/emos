generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum MemberRole {
  DEVELOPER
  QA
  MANAGER
}

enum WorkItemType {
  ISSUE
  MERGE_REQUEST
  EPIC
}

enum WorkItemState {
  OPEN
  IN_PROGRESS
  IN_REVIEW
  QA
  BLOCKED
  DONE
  CLOSED
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum HealthStatus {
  HEALTHY
  AT_RISK
  CRITICAL
  UNKNOWN
}

enum SyncSource {
  GITLAB_API
  DOM_EXTRACTION
  MANUAL
}

enum ReleaseStream {
  PRODUCT
  OBSERVATIONS
  MOBILE
}

enum Connect3030Status {
  PENDING
  SCHEDULED
  COMPLETED
  SKIPPED
}

enum SprintEvaluationRunMode {
  ANALYZE
  APPLY
}

enum SprintEvaluationRunStatus {
  PENDING
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
  STALE
  REJECTED
}

enum SprintEvaluationTrigger {
  MANUAL
  SCHEDULED_PERIODIC
  SPRINT_START
  DURING_SPRINT
  SPRINT_END
  RETRY
  POST_SPRINT_RECONCILIATION
}

enum SprintLabelActionType {
  ADD
  REMOVE
}

enum SprintLabelActionStatus {
  PLANNED
  SKIPPED
  APPLIED
  FAILED
  NO_OP
  REJECTED
}

// ─── Team & People ───────────────────────────────────────────────────────────

model Team {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  members   TeamMember[]
  sprints   Sprint[]
}

model TeamMember {
  id           String     @id @default(cuid())
  teamId       String
  name         String
  email        String?
  role         MemberRole @default(DEVELOPER)
  gitlabUserId Int?
  gitlabHandle String?
  capacity     Int        @default(40)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  team             Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  workItems        WorkItem[]           @relation("Assignee")
  reviews          WorkItem[]           @relation("Reviewer")
  qaOwnedWorkItems WorkItem[]           @relation("QaOwner")
  connectSessions  Connect3030Session[]

  @@unique([teamId, email])
  @@index([teamId])
}

// ─── GitLab Projects & Workflows ─────────────────────────────────────────────

model GitLabProject {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  gitlabId      Int?     @unique
  gitlabPath    String?
  description   String?
  webUrl        String?
  defaultBranch String   @default("main")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workflow  ProjectWorkflow?
  workItems WorkItem[]
  releases  Release[]
  sprints   Sprint[]
}

model ProjectWorkflow {
  id        String   @id @default(cuid())
  projectId String   @unique
  name      String
  isDefault Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project GitLabProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns WorkflowColumn[]
}

model WorkflowColumn {
  id         String   @id @default(cuid())
  workflowId String
  name       String
  slug       String
  position   Int
  color      String?
  wipLimit   Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  workflow  ProjectWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workItems WorkItem[]

  @@unique([workflowId, slug])
  @@index([workflowId])
}

// ─── Delivery ────────────────────────────────────────────────────────────────

model Sprint {
  id                String   @id @default(cuid())
  teamId            String
  projectId         String?
  gitlabMilestoneId Int?     @unique
  name              String
  goal              String?
  startDate         DateTime
  endDate           DateTime
  isActive          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  team      Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project   GitLabProject? @relation(fields: [projectId], references: [id])
  workItems WorkItem[]

  @@index([teamId])
  @@index([projectId])
}

model Release {
  id          String    @id @default(cuid())
  projectId   String
  version     String
  name        String?
  description String?
  targetDate  DateTime?
  releasedAt  DateTime?
  isDraft     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project GitLabProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, version])
  @@index([projectId])
}

model ReleaseEpic {
  id            String        @id @default(cuid())
  gitlabGroupId Int
  epicIid       Int
  workItemId    Int?
  title         String
  monthKey      String
  stream        ReleaseStream
  state         String        @default("opened")
  webUrl        String?
  description   String?
  startDate     DateTime?
  dueDate       DateTime?
  lastSyncedAt  DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([gitlabGroupId, epicIid])
  @@index([monthKey])
  @@index([state])
  @@index([stream])
}

// ─── Work Items (Issues, MRs) ────────────────────────────────────────────────

model WorkItem {
  id                  String        @id @default(cuid())
  projectId           String
  sprintId            String?
  columnId            String?
  assigneeId          String?
  reviewerId          String?
  type                WorkItemType
  state               WorkItemState @default(OPEN)
  priority            Priority      @default(MEDIUM)
  health              HealthStatus  @default(UNKNOWN)
  gitlabIid           Int?
  gitlabId            Int?          @unique
  title               String
  description         String?
  labels              String[]      @default([])
  milestoneId         Int?
  milestoneTitle      String?
  storyPoints         Int?
  dueDate             DateTime?
  blockedReason       String?
  reviewStatus        String?
  qaStatus            String?
  lastActivityAt      DateTime?
  parentEpicIid       Int?
  timeSpentSeconds    Int?
  timeEstimateSeconds Int?
  qaOwnerId           String?
  syncSource          SyncSource    @default(MANUAL)
  webUrl              String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  project  GitLabProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint   Sprint?         @relation(fields: [sprintId], references: [id])
  column   WorkflowColumn? @relation(fields: [columnId], references: [id])
  assignee TeamMember?     @relation("Assignee", fields: [assigneeId], references: [id])
  reviewer TeamMember?     @relation("Reviewer", fields: [reviewerId], references: [id])
  qaOwner  TeamMember?     @relation("QaOwner", fields: [qaOwnerId], references: [id])

  @@index([projectId])
  @@index([assigneeId])
  @@index([qaOwnerId])
  @@index([state])
  @@index([priority])
  @@index([parentEpicIid])
}

// ─── Governance ──────────────────────────────────────────────────────────────

model GovernanceRule {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  category    String
  severity    String   @default("warning")
  isEnabled   Boolean  @default(true)
  config      Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Sync & Jobs ─────────────────────────────────────────────────────────────

model SyncRun {
  id         String     @id @default(cuid())
  source     SyncSource
  entityType String
  status     String     @default("pending")
  startedAt  DateTime   @default(now())
  finishedAt DateTime?
  itemsCount Int        @default(0)
  error      String?
  metadata   Json       @default("{}")

  @@index([source, entityType])
  @@index([startedAt])
}

// ─── GitLab Comments Monitor Audit ───────────────────────────────────────────

model GitLabActionAudit {
  id         String   @id @default(cuid())
  actionType String
  targetType String
  projectId  Int
  targetIid  Int
  payload    Json     @default("{}")
  result     String
  error      String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([projectId, targetIid])
}

// ─── FY Planning ─────────────────────────────────────────────────────────────

model PlanningDocument {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  fiscalYear String
  sheets     Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model RoadmapDocument {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  fiscalYear   String
  sourceSheet  String        @default("FY27 V1")
  /// Legacy JSON blob. Prefer `items` relation; kept for one-time migration.
  itemsJson    Json          @default("[]") @map("items")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  items        RoadmapItem[]
}

model RoadmapItem {
  id          String   @id @default(cuid())
  documentId  String
  priority    String
  include     String
  project     String
  category    String
  quarter     String
  timeline    String   @default("")
  assignee    String   @default("")
  /// number or "TBD"
  hours       Json
  core        Boolean  @default(false)
  mobile      Boolean  @default(false)
  data        Boolean  @default(false)
  title         String
  description   String   @default("") @db.Text
  /// GitLab-ready title (AI-generated or edited). Used when creating GitLab issues.
  aiTitle       String   @default("") @map("ai_title")
  /// GitLab-ready description (AI-generated or edited). Used when creating GitLab issues.
  aiDescription String   @default("") @map("ai_description") @db.Text
  gitlab        Json?
  hoursSpent  Float?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  document RoadmapDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([documentId, position])
}

model KpiSheetDocument {
  id         String   @id @default(cuid())
  slug       String   @unique
  team       String
  fiscalYear String
  sheetData  Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── 30:30 Connect (monthly 1:1) ─────────────────────────────────────────────

model Connect3030Session {
  id          String            @id @default(cuid())
  memberId    String
  monthKey    String
  status      Connect3030Status @default(PENDING)
  scheduledAt DateTime?
  completedAt DateTime?
  autoBrief   Json              @default("{}")
  responses   Json              @default("{}")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  member TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, monthKey])
  @@index([monthKey])
  @@index([memberId])
}

// ─── Sprint Intelligence ─────────────────────────────────────────────────────

model SprintEvaluationRun {
  id                   String                    @id @default(cuid())
  runKey               String                    @unique
  correlationId        String
  mode                 SprintEvaluationRunMode
  status               SprintEvaluationRunStatus @default(PENDING)
  triggerType          SprintEvaluationTrigger   @default(MANUAL)
  projectIds           Int[]
  milestoneId          Int
  milestoneTitle       String
  milestoneStartDate   String?
  milestoneDueDate     String?
  timezone             String                    @default("Asia/Kolkata")
  ruleConfigSnapshot   Json                      @default("{}")
  inputHash            String?
  analysisHash         String?
  sourceAnalysisRunId  String?
  startedAt            DateTime?
  completedAt          DateTime?
  requestedAt          DateTime                  @default(now())
  requestedBy          String?
  jobId                String?
  dryRun               Boolean                   @default(true)
  confirmationRequired Boolean                   @default(false)
  summary              Json                      @default("{}")
  metrics              Json                      @default("{}")
  errorCode            String?
  errorMessage         String?
  automationVersion    String                    @default("1.0.0")
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  sourceAnalysisRun SprintEvaluationRun?          @relation("ApplySourceAnalysis", fields: [sourceAnalysisRunId], references: [id])
  applyRuns         SprintEvaluationRun[]         @relation("ApplySourceAnalysis")
  issueEvaluations  SprintIssueEvaluation[]
  labelActions      SprintLabelAction[]
  ownershipRecords  SprintManagedLabelOwnership[] @relation("OwnershipSourceRun")

  @@index([status])
  @@index([mode])
  @@index([milestoneId])
  @@index([createdAt])
  @@index([jobId])
  @@index([sourceAnalysisRunId])
  @@index([triggerType, milestoneId, status])
}

model SprintIssueEvaluation {
  id                               String    @id @default(cuid())
  runId                            String
  projectId                        Int
  issueId                          Int
  issueIid                         Int
  issueTitle                       String
  milestoneId                      Int
  milestoneTitle                   String
  assignmentTimestamp              DateTime?
  removalTimestamp                 DateTime?
  completionTimestamp              DateTime?
  planningStatus                   String
  deliveryStatus                   String
  workTypes                        String[]  @default([])
  excludedFromCommitment           Boolean   @default(false)
  completedWithinSprint            Boolean   @default(false)
  existingLabels                   String[]  @default([])
  recommendedLabelsToAdd           String[]  @default([])
  recommendedManagedLabelsToRemove String[]  @default([])
  reasonCodes                      String[]  @default([])
  eventResolutionDetails           Json      @default("{}")
  evaluationErrorCode              String?
  evaluationErrorMessage           String?
  createdAt                        DateTime  @default(now())

  run          SprintEvaluationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  labelActions SprintLabelAction[]

  @@unique([runId, projectId, issueIid])
  @@index([runId])
  @@index([projectId, issueIid])
  @@index([milestoneId])
  @@index([planningStatus])
  @@index([deliveryStatus])
}

model SprintLabelAction {
  id                   String                  @id @default(cuid())
  runId                String
  issueEvaluationId    String?
  projectId            Int
  issueIid             Int
  label                String
  action               SprintLabelActionType
  status               SprintLabelActionStatus @default(PLANNED)
  ownedBefore          Boolean                 @default(false)
  ownedAfter           Boolean?
  plannedAt            DateTime                @default(now())
  attemptedAt          DateTime?
  completedAt          DateTime?
  gitlabResponseStatus Int?
  errorCode            String?
  errorMessage         String?
  createdAt            DateTime                @default(now())

  run             SprintEvaluationRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  issueEvaluation SprintIssueEvaluation?       @relation(fields: [issueEvaluationId], references: [id], onDelete: SetNull)
  ownership       SprintManagedLabelOwnership? @relation("OwnershipSourceAction")

  @@index([runId])
  @@index([projectId, issueIid])
  @@index([status])
  @@index([issueEvaluationId])
}

model SprintManagedLabelOwnership {
  id                  String    @id @default(cuid())
  projectId           Int
  issueIid            Int
  milestoneId         Int
  label               String
  ruleId              String?
  sourceRunId         String?
  sourceLabelActionId String?   @unique
  isActive            Boolean   @default(true)
  acquiredAt          DateTime  @default(now())
  releasedAt          DateTime?
  lastVerifiedAt      DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sourceRun         SprintEvaluationRun? @relation("OwnershipSourceRun", fields: [sourceRunId], references: [id], onDelete: SetNull)
  sourceLabelAction SprintLabelAction?   @relation("OwnershipSourceAction", fields: [sourceLabelActionId], references: [id], onDelete: SetNull)

  @@unique([projectId, issueIid, milestoneId, label])
  @@index([projectId, issueIid])
  @@index([milestoneId])
  @@index([label])
  @@index([isActive])
  @@index([projectId, issueIid, label, isActive])
}

model SprintIntelligenceProjectConfig {
  id                            String   @id @default(cuid())
  projectId                     Int      @unique
  enabled                       Boolean?
  dryRunOnly                    Boolean?
  timezone                      String?
  allowFirstDayAdditions        Boolean?
  createMissingLabels           Boolean?
  removeInvalidManagedLabels    Boolean?
  supportExcludedFromCommitment Boolean?
  hotfixExcludedFromCommitment  Boolean?
  uatExcludedFromCommitment     Boolean?
  allowTitleOnlyMilestoneMatch  Boolean?
  maxConcurrency                Int?
  maxPages                      Int?
  maxAnalysisAgeMinutes         Int?
  scheduleEnabled               Boolean?
  duringSprintIntervalMinutes   Int?
  ruleConfigOverrides           Json     @default("{}")
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  @@index([projectId])
  @@index([enabled])
}
